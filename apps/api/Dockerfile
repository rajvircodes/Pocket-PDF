FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libreoffice qpdf ghostscript && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
COPY apps/api/package.json apps/api/package.json
RUN npm install --workspace @pocket-pdf/api
COPY apps/api ./apps/api
WORKDIR /app/apps/api
RUN npm run build
EXPOSE 4000
CMD ["npm", "run", "start"]
